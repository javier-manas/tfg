{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: CUDA Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "envFile": "${workspaceFolder}/.env",
            "python": "${config:python.pythonPath}",
            "console": "integratedTerminal"
        }
    ]
}
